# No API key is needed for the preset demo adventure.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
HEXBOUND_DB=data/hexbound.sqlite3

# Configure before first deployment; no default administrator password exists.
HEXBOUND_BOOTSTRAP_ADMIN_USERNAME=
HEXBOUND_BOOTSTRAP_ADMIN_PASSWORD=
HEXBOUND_ALLOW_REGISTRATION=1
HEXBOUND_SESSION_TTL_SECONDS=604800
# Set to 1 behind an HTTPS reverse proxy. Leave unset for auto-detection.
# HEXBOUND_COOKIE_SECURE=1

# Temporary migration switches; both disabled by default.
HEXBOUND_ALLOW_GUESTS=0
HEXBOUND_LEGACY_ADMIN_TOKEN=0
HEXBOUND_ADMIN_TOKEN=
